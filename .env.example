# Copy to .env.local for local development. On Hostinger, add these as environment
# variables in hPanel (Websites → your Node.js app → Environment variables).
# Never commit real passwords.

# ---------------------------------------------------------------- Site
# Public URL, no trailing slash. Used for canonicals, sitemap and emails. Build-time.
NEXT_PUBLIC_SITE_URL=https://scrapbaysltd.com
# Shown in the header/footer and emails. Build-time (rebuild after changing).
NEXT_PUBLIC_CONTACT_EMAIL=info@scrapbaysltd.com
NEXT_PUBLIC_CONTACT_PHONE=+44 7985 714297

# ---------------------------------------------------------------- Email (Titan Mail via Hostinger)
SMTP_HOST=smtp.titan.email
# 465 = SSL (recommended). For 587 set SMTP_SECURE=false (STARTTLS).
SMTP_PORT=465
SMTP_SECURE=true
# Full mailbox address and its password
SMTP_USER=info@scrapbaysltd.com
SMTP_PASS=
# Titan only lets you send as the authenticated mailbox
MAIL_FROM="Scrap Bays Limited <info@scrapbaysltd.com>"
# Where new orders/enquiries are sent (comma-separated for several)
MAIL_TO=info@scrapbaysltd.com
# Optional hidden copy of every business notification
MAIL_BCC=

# Bank details included in order confirmations (use \n for new lines). Leave empty to omit.
BANK_DETAILS=

# ---------------------------------------------------------------- Orders & enquiries storage
# Folder where orders/enquiries (JSON) and uploaded photos are saved. On Hostinger use a
# folder OUTSIDE the app directory so deployments don't wipe it, e.g.
# /home/u123456789/scrapbay-storage
STORAGE_DIR=./storage

# ---------------------------------------------------------------- Admin (/admin/orders/)
# HTTP Basic auth. Admin is disabled (404) while ADMIN_PASSWORD is empty.
ADMIN_USER=admin
ADMIN_PASSWORD=

# ---------------------------------------------------------------- Search engine verification (optional, build-time)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
